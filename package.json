{
  "name": "mirror-manager",
  "version": "0.0.0",
  "description": "Manage mirroring repositories from GitLab to GitHub",
  "keywords": [
    "oclif"
  ],
  "author": "Jacques Hoffmann",
  "bin": {
    "mirror-manager": "./bin/run.js"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "yarn typegen && shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "yarn lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "yarn typegen && mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "typegen": "tsx compile_schema.ts"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "@octokit/auth-oauth-app": "^9.0.3",
    "ajv": "^8.20.0",
    "date-fns": "^4.4.0",
    "js-yaml": "^5.5.0",
    "json-schema-to-typescript": "^16.0.0",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "prettier": "^3.9.5",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "oclif": {
    "bin": "mirror-manager",
    "commands": "./dist/commands",
    "dirname": "mirror-manager",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
